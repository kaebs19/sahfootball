# ملك التوقعات — إعدادات السيرفر.
#
# انسخ هذا الملف إلى .env واملأه. لا ترفع .env إلى git أبداً:
# فيه مفتاح المزوّد وسر توقيع التوكنات.
#
# في الإنتاج يرفض السيرفر الإقلاع لو كان أي من الإعدادات الحرجة
# ناقصاً أو ما زال قيمة المثال — انظر src/config/env.js.

# ───────────────────────── أساسيات ─────────────────────────

PORT=3000

# production تفعّل فحوصات الإعداد الصارمة. اتركها development محلياً.
NODE_ENV=development

# ───────────────────────── التخزين ─────────────────────────

DATABASE_URL=postgresql://user:pass@localhost:5432/sahfootball
REDIS_URL=redis://localhost:6379

# مجلد الصور المرفوعة (صور المستخدمين).
#
# في الإنتاج وجّهه لقرص دائم. الافتراضي داخل المشروع، ومعظم منصات
# الاستضافة تمسح قرص المشروع مع كل نشر — فتختفي الصور بينما تبقى
# مساراتها مسجّلة في القاعدة.
# UPLOADS_DIR=/var/lib/malik/uploads

# ───────────────────────── الأمان ──────────────────────────

# سر توقيع التوكنات. ولّد واحداً فريداً لكل بيئة:
#   openssl rand -hex 32
# تغييره يُخرج كل المستخدمين، وتسريبه يعني أن أي شخص يستطيع
# تزوير توكن لأي حساب.
JWT_SECRET=change-me-generate-with: openssl rand -hex 32

# عدد طبقات البروكسي أمام السيرفر (nginx = 1، Cloudflare+nginx = 2).
# اتركه فارغاً لو لا بروكسي أمامك: الثقة بلا بروكسي تسمح للزائر
# بانتحال عنوانه وتجاوز حدود السبام.
# TRUST_PROXY=1

# النطاقات المسموح لها بمناداة الـ API من المتصفح، مفصولة بفاصلة.
# غير لازم حين تُخدم اللوحة من نفس السيرفر (/admin) — نفس الأصل.
# تطبيق الجوال لا يتأثر: CORS قاعدة متصفح لا شبكة.
# CORS_ORIGINS=https://admin.example.com

# مجلد نسخة اللوحة المبنية. الافتراضي ../admin/dist
# ADMIN_DIST=/var/www/malik-admin

# ─────────────────── مزوّد بيانات المباريات ───────────────────

FOOTBALL_API_KEY=
FOOTBALL_API_URL=https://v3.football.api-sports.io
LEAGUE_ID=307

# الخطة المجانية تخدم مواسم 2022–2024 فقط، والموسم الحالي يحتاج
# اشتراكاً مدفوعاً. مع الخطة المجانية استخدم 2024.
SEASON=2024

# true يقرأ من server/samples/ بلا أي نداء للمزود — للتجربة المحلية.
# مرفوض في الإنتاج: سيخدم المستخدمين بيانات ثابتة بدل مباريات حقيقية.
USE_SAMPLES=false

# حد الطلبات اليومي حسب اشتراكك:
#   المجانية 100 · Pro 7500 · Ultra 75000 · Mega 150000
# نمنع التجاوز من جهتنا. تركه على 100 بعد الترقية يوقف المزامنة
# مبكراً بينما اشتراكك يسمح بأضعافه — عطل يبدو كأن المزوّد رفض.
FOOTBALL_DAILY_LIMIT=100

# ───────────────────────── البريد ──────────────────────────

# console | resend | mailgun
#
# console يطبع الرسالة في اللوق ولا يرسل شيئاً. مقبول محلياً، لكنه
# في الإنتاج يعني أن رمز استعادة كلمة المرور لا يصل لأحد ومن ينسى
# كلمته يفقد حسابه. اضبط مزوّداً حقيقياً قبل استقبال مستخدمين.
MAIL_DRIVER=console

# عنوان المرسل. إلزامي مع أي مزوّد حقيقي، ويجب أن يكون على نطاق
# وثّقته لدى المزوّد (سجلات DNS) — وإلا رُفضت كل رسالة.
# MAIL_FROM=ملك التوقعات <no-reply@example.com>

# resend: مفتاح واحد من https://resend.com/api-keys
# RESEND_API_KEY=re_...

# mailgun: المفتاح والنطاق من لوحة التحكم.
# انتبه للمنطقة: حساب أُنشئ في الاتحاد الأوروبي يرد 401 على النطاق
# الأمريكي وكأن المفتاح خاطئ.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_REGION=eu

# بعد الضبط، تحقق قبل أن يحتاجه مستخدم:
#   node scripts/sendTestMail.js you@example.com

# ──────────────────────── تسجيل الدخول ─────────────────────

APPLE_BUNDLE_ID=com.sahfootball.app

# ───────────────────────── المزامنة ────────────────────────

# نسخة واحدة فقط يجب أن تزامن. لو شغّلت أكثر من نسخة، اترك هذا
# true في واحدة و false في البقية — وإلا تضاعف استهلاك حصة المزوّد.
ENABLE_SCHEDULER=true
SYNC_FULL_HOURS=6
SYNC_LIVE_SECONDS=300
