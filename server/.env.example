PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:pass@localhost:5432/sahfootball
REDIS_URL=redis://localhost:6379

FOOTBALL_API_KEY=
FOOTBALL_API_URL=https://v3.football.api-sports.io
LEAGUE_ID=307
SEASON=2025

USE_SAMPLES=true

JWT_SECRET=change-me-generate-with: openssl rand -hex 32
MAIL_DRIVER=console
APPLE_BUNDLE_ID=com.sahfootball.app
ENABLE_SCHEDULER=true
SYNC_FULL_HOURS=6
SYNC_LIVE_SECONDS=300
