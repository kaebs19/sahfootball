<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- قدرة الإشعارات. بلا هذا المفتاح يفشل
	     registerForRemoteNotifications ولا يصل توكن أبداً.
	     development هنا، وXcode يبدّلها إلى production تلقائياً في
	     أرشيف التوزيع. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
