<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- قدرة الإشعارات. بلا هذا المفتاح يفشل
	     registerForRemoteNotifications ولا يصل توكن أبداً.
	     development هنا، وXcode يبدّلها إلى production تلقائياً في
	     أرشيف التوزيع. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- الدخول بحساب Apple. القدرة مفعّلة أصلاً على App ID
	     com.sahfootball.app في البوابة (هوية الويب مجمّعة تحته)،
	     وهذا السطر يطلبها لهذا التطبيق تحديداً. بدونه ترفض
	     AuthenticationServices الطلب قبل أن تعرض أي نافذة. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- روابط الدعوة (Universal Links): sahfootball.com/join/XXXXXX
	     يفتح التطبيق مباشرة بدل المتصفح. النظام يقرأ
	     /.well-known/apple-app-site-association من النطاق عند
	     التثبيت ليتحقق أن النطاق يسمح لهذا التطبيق (يولّده السيرفر
	     من APPLE_TEAM_ID، راجع server/src/app.js). يتطلّب تفعيل
	     Associated Domains على App ID في بوابة آبل. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sahfootball.com</string>
	</array>
</dict>
</plist>
