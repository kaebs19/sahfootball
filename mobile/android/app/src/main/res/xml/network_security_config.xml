<?xml version="1.0" encoding="utf-8"?>
<!--
  أندرويد يمنع HTTP غير المشفّر افتراضياً، وسيرفر التطوير يعمل على
  http://localhost — يراه المحاكي على 10.0.2.2 ولا يصله بلا استثناء.

  الاستثناء محصور بعناوين الجهاز المحلي، ولهذا يصح بقاؤه في نسخة
  الإصدار أيضاً: تطبيق منشور لا يخاطب 10.0.2.2 ولا localhost أبداً،
  فالاستثناء بلا أثر عليه. البديل — ملف خاص بنسخة التطوير — يجعل
  نسخة الإصدار تسلك مساراً شبكياً لم يُجرَّب قط قبل النشر.

  ما لا يجوز أبداً: cleartextTrafficPermitted عاماً بلا نطاقات، فهو
  يجعل بيانات المستخدمين قابلة للاعتراض على أي شبكة.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
