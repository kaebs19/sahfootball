<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- بدونها لا يصل التطبيق للسيرفر إطلاقاً في نسخة الإصدار.
         نسخة التطوير كانت تعمل لأن ملف debug/AndroidManifest.xml
         يضيفها لأدوات فلاتر — فالعطل كان سيظهر أول مرة على متجر
         Google Play لا على أي جهاز تطوير. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- أندرويد 13 (API 33) نقل الإشعارات من "مسموحة تلقائياً" إلى
         صلاحية تُطلب من المستخدم. بدون هذا السطر لا يظهر أي طلب
         ولا يصل أي إشعار على الأجهزة الحديثة — بصمت، بلا خطأ. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="ملك التوقعات"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- روابط الدعوة (App Links): sahfootball.com/join/… يفتح
                 التطبيق. autoVerify يجعل أندرويد يتحقق من
                 /.well-known/assetlinks.json على النطاق عند التثبيت،
                 وذلك الملف يحتاج بصمة شهادة التوقيع (ANDROID_CERT_SHA256
                 على السيرفر) — بدونها يفتح الرابط المتصفح ولا يكسر
                 شيئاً. المسار /join فقط: بقية الموقع تبقى للمتصفح. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="sahfootball.com" android:pathPrefix="/join/"/>
            </intent-filter>
        </activity>
        <!-- خدمة استقبال رسائل FCM. مطلوبة لعرض الإشعار والتطبيق
             في المقدمة — أندرويد لا يعرضه تلقائياً في تلك الحالة. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- أيقونة الإشعار ولونه.
             بدون السطر الأول يستخدم أندرويد أيقونة التطبيق الملوّنة
             ويحوّلها لمربّع أبيض مصمت. واللون هو الأخضر الذي يصبغ
             به النظام الأيقونة والاسم في شريط الإشعارات. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- القناة الافتراضية: أندرويد 8+ يرفض أي إشعار بلا قناة.
             FCM ينشئ قناة احتياطية باسم "Miscellaneous" لو لم نحدد
             واحدة — اسم يظهر للمستخدم في إعدادات الهاتف ولا يعني له
             شيئاً. القناة معرّفة في MainActivity باسم عربي مفهوم. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="malik_default" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- معرّف تطبيق AdMob — يقرؤه SDK عند الإقلاع (نظير
             GADApplicationIdentifier في iOS). القيمة الحالية معرّف
             جوجل التجريبي؛ استبدلها بمعرّفك قبل النشر. وغيابه يجعل
             التطبيق ينهار عند أول إعلان لا يفشل بصمت. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
